# ── Server ──────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/enterprise_auth

# ── JWT ───────────────────────────────────────
# IMPORTANT: Use long, random strings in production
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars!!
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_DAYS=7

# ── Email / SMTP ──────────────────────────────
# Use Ethereal (https://ethereal.email) for local dev
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_user
SMTP_PASS=your_ethereal_pass
EMAIL_FROM=noreply@enterprise.local
EMAIL_FROM_NAME=Enterprise Auth

# ── App URLs ──────────────────────────────────
CLIENT_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000

# ── Security ─────────────────────────────────
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15

# ── Token TTLs ────────────────────────────────
EMAIL_VERIFY_TOKEN_EXPIRES_MS=86400000    # 24 hours
PASSWORD_RESET_TOKEN_EXPIRES_MS=3600000   # 1 hour

# ── CORS ─────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS=900000   # 15 min
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
